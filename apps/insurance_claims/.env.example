# Copy this file to ".env" and put your real values in it. Never commit .env.

# The provider: openrouter, openai, or anthropic (presets in sop_agent/config.py).
LLM_PROVIDER=openrouter
# Optional. Empty = the provider's default model.
# LLM_MODEL=openai/gpt-6-luna

# The key for your provider (only the one you use). LLM_API_KEY also works for any provider.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: any other OpenAI-compatible server, with LLM_PROVIDER=openai.
# LLM_BASE_URL=http://localhost:11434/v1

# Optional demo settings:
# DEMO_TODAY=2026-02-15
# CONSENT_SCENARIO=default
